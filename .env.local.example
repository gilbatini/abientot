# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (contact form notifications)
RESEND_API_KEY=

# Google Places API — powers the live Google reviews on /reviews.
# Enable "Places API (New)" in Google Cloud Console and restrict the key
# to that API. Without it, /reviews falls back to static testimonials.
GOOGLE_PLACES_API_KEY=
