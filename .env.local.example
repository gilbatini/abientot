# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.abientottours.com

# ── Google Places API (live reviews) ──────────────────────
# Server-side only — do NOT prefix with NEXT_PUBLIC (that would expose the key
# in the browser). When set, the homepage + /reviews pull live reviews from the
# Google Business Profile via the Places API (New); when unset, the site falls
# back to the static reviews in lib/constants.ts.
#
# Setup:
#   1. Google Cloud Console → enable "Places API (New)".
#   2. APIs & Services → Credentials → create an API key.
#   3. Restrict the key to the Places API (and, ideally, your server IPs).
#   4. Add it below locally, and in Vercel → Project → Settings → Environment
#      Variables (Production + Preview), then redeploy.
GOOGLE_PLACES_API_KEY=
